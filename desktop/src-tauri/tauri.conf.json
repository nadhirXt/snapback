{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapBack",
  "version": "1.0.0",
  "identifier": "com.snapback.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SnapBack — Planificateur Focus",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "SnapBack — Concentre-toi",
        "url": "overlay.html",
        "width": 640,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
